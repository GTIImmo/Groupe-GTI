VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_BACKEND_API_URL=http://127.0.0.1:8010
VITE_GOOGLE_WORKSPACE_DOMAIN=gti-immobilier.fr
VITE_APP_PUBLIC_URL=https://groupe-gti.vercel.app
# Cockpit v2 (refonte Détail annonce) — OFF par défaut. Lu au BUILD par Vite :
# toute bascule Vercel exige un redéploiement (ou un rebuild) pour prendre effet.
VITE_APP_COCKPIT_V2_ENABLED=
# Fiche Contact v2 (refonte maquette detail-contact-v30) — OFF par défaut. Lu au BUILD par Vite :
# toute bascule Vercel exige un redéploiement (ou un rebuild) pour prendre effet.
VITE_APP_CONTACT_V2_ENABLED=
# bienvu (refonte graphique, charte d'octobre 2026) — OFF par défaut. Lu au BUILD par Vite :
# toute bascule Vercel exige un redéploiement (ou un rebuild) pour prendre effet.
# Allumé, il pose la classe .bv sur <html> et active bienvu.css ; éteint, aucun pixel ne change.
VITE_APP_BIENVU_ENABLED=
